{
  "name": "kittie",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start --port 3100",
    "start:test": "next start --port 3100",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "echo 'db:generate: pending todo 2, Drizzle schema and migrations'",
    "db:migrate": "echo 'db:migrate: pending todo 2, Drizzle migrations'",
    "db:seed": "echo 'db:seed: pending todo 2, seed data'",
    "db:reset": "echo 'db:reset: pending todo 2, reset database'",
    "worker": "echo 'worker: pending todo 16, OCR and notification jobs'",
    "verify": "bun run typecheck && bun run lint && bun run test && bun run test:integration && bun run build && bun run test:e2e"
  },
  "dependencies": {
    "@google/genai": "2.32.0",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "next": "16.4.4",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.4",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vitest": "3.2.7"
  },
  "packageManager": "bun@1.4.0",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
