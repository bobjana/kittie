# ---- Postgres (compose.yml publishes host 5433 -> container 5432) ----
DATABASE_URL=postgres://kittie:kittie@localhost:5433/kittie
TEST_DATABASE_URL=postgres://kittie:kittie@localhost:5433/kittie_test

# ---- App / auth ----
APP_URL=http://localhost:3100
BETTER_AUTH_URL=http://localhost:3100
# 32+ char random secret. Use a real random value for production; the value below is local-only.
BETTER_AUTH_SECRET=change-me-to-a-32-plus-character-random-secret
# Optional. Defaults to the APP_URL protocol (https -> true, http -> false).
COOKIE_SECURE=false

# ---- Email ----
# EMAIL_DRIVER: "smtp" (local Mailpit) or "resend".
EMAIL_DRIVER=smtp
EMAIL_FROM=Kittie <kittie@localhost>
# Required only when EMAIL_DRIVER=resend
RESEND_API_KEY=
# Required only when EMAIL_DRIVER=smtp
SMTP_URL=smtp://localhost:1025

# ---- OCR ----
# OCR_PROVIDER: "gemini" or "fake" (fake is used in tests and local dev).
OCR_PROVIDER=fake
# Required only when OCR_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OCR_INLINE=false
OCR_MONTHLY_JOB_CAP=10000

# ---- Receipts ----
RECEIPT_STORAGE_DIR=receipts
RECEIPT_MAX_BYTES=10485760

# ---- Notifications ----
NOTIFICATIONS_INLINE=false

# ---- Cloudflare Tunnel (production cloudflared profile only) ----
CF_TUNNEL_TOKEN=

# ---- Logging ----
LOG_LEVEL=info
